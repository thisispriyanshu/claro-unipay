# Copy to .env.local and fill in. Missing keys fall back to mock data where possible.

# --- OpenAI — the agent model ---
OPENAI_API_KEY=
# Optional: override the model (defaults to gpt-4o).
OPENAI_MODEL=gpt-4o

# --- Channel3 (product discovery) ---
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com

# --- PayPal (sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# SANDBOX or PRODUCTION (the Agent Toolkit reads this casing).
PAYPAL_ENVIRONMENT=SANDBOX
# REST base; sandbox by default.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Public client id for the browser checkout button (same as PAYPAL_CLIENT_ID in sandbox).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Comma-separated PayPal sandbox merchant IDs used as multi-payee receivers.
NEXT_PUBLIC_PAYPAL_MERCHANT_IDS=2AY38ZW9RL536,XCLG3AJY87NH4,7MQJPKQEH565W

# --- App ---
# Comma-separated sandbox merchant receiver emails used for the Payouts split demo.
DEMO_MERCHANT_EMAILS=
